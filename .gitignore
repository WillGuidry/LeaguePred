# Data files (large CSVs shouldn't live in git)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/features/*.csv
data/models/*.pkl
data/models/*.joblib

# Keep the directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
!data/models/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Environment variables / secrets
.env
*.env

# Logs
*.log
